{
  "name": "widgetforge-demo",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end reference application for WidgetForge",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names client,server --prefix-colors blue,green \"npm run dev --workspace @widgetforge-demo/client\" \"npm run dev --workspace @widgetforge-demo/server\"",
    "dev:client": "npm run dev --workspace @widgetforge-demo/client",
    "dev:server": "npm run dev --workspace @widgetforge-demo/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.10",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  }
}
